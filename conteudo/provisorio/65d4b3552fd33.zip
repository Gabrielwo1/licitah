<html lang="pt-BR">
   <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
      
      <title></title>
    
      <script>
         const dominio = "https://nown.com.br";
         const dominioAdress = dominio
      </script>

 
      <link rel="manifest" href="https://nown.com.br/manifest.json">      
      <style>
      .material-symbols-outlined{
          display: none;
      }
      
          .floating-logo {
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-20px);
    }
}
      </style>
     
   </head>
   <body class="light" data-css="nown-theme.5619.css">
        <div style="position: fixed; top: 0px; left: 0px; width: 100%; height: 100vh; z-index: 2000; background-color: white; display: flex; align-items: center; justify-content: center" id="firstLoad">
           <div class="d-flex justify-content-center">
  <div class="spinner-border" role="status">
    <span class="visually-hidden">Carregando ...</span>
  </div>
</div>
       </div>
      <div class="position-fixed start-0 h-100 d-none" id="lateral">
         <div class="card h-100 rounded-0 border-0">
            <div class="card-header rounded-0 border-0 shadow ">
               <div class="he-50" id="logoRetratil">
                 
               </div>
            </div>
            <div class="card-body">
               <div>
                  <div class="accordion" id="menuLateral">
                     <div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div><div class="bg-carregando mb-2 he-50"></div>                  </div>
               </div>
            </div>
            <div class="card-footer">
               <div class="he-30">
                  <div class="bg-carregando h-100">
                  </div>
               </div>
            </div>
         </div>
      </div>
      <div class="card h-100 rounded-0 border-0"  id="corpo" style="margin-left: 0px">
         <div class="progress position-absolute top-0 w-100 start-0 rounded-0 bg-transparent" style="height:3px" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"  id="barraCarregamento"></div>
         </div>
         <div class="card-header rounded-0 border-0 shadow" id="topo">
            <div class="he-50 d-flex justify-content-between align-items-center container">
               <div class="esquerda d-flex justify-content-between align-items-center gap-2">
                  <div class="bg-carregando he-50 wi-50"></div>
               </div>
               <div class="centro">
                  <div class="bg-carregando he-50 wi-100"></div>
               </div>
               <div class="direita d-flex justify-content-between align-items-center gap-3">
                  <div class="bg-carregando he-30 wi-30"></div>
                  <div class="bg-carregando he-30 wi-30"></div>
                  <div class="bg-carregando he-30 wi-30"></div>
               </div>
            </div>
         </div>
         <div class="card-body overflow-y-auto overflow-x-hidden" id="conteudo">
            <div class="d-flex justify-content-center align-items-center h-100">
               <div class="spinner-grow text-secondary" role="status">
                  <span class="visually-hidden">Carregando ...</span>
               </div>
            </div>
         </div>
         <div id="rodape" class="card-footer d-xl-none p-0 position-fixed bottom-0 w-100 bg-dark">
         </div>
      </div>
      <div class="position-fixed bottom-0 right-0"  style="right: 0px" id="toastContainer">
          
      </div>
   </body>
   <script src="https://nown.com.br/assets/js/pwa.js" id="pwaScript"></script>

   <script src="https://nown.com.br/assets/js/index.js?v=1952776346090340"></script>

</html> 